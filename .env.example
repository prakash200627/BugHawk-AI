# ============================================================
# BugHawk AI 2.0 — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
# Production (APP_ENV=production) refuses startup unless APP_SECRET_KEY and
# JWT_SECRET_KEY are each at least 32 characters, and ALLOWED_ORIGINS is set
# to the real frontend origin (localhost is rejected).
APP_SECRET_KEY=replace-with-a-long-random-string
# Ignored when APP_ENV=production. Production always runs with debug off.
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://bughawk:replace-with-a-local-password@localhost:5432/bughawk_db
POSTGRES_USER=bughawk
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=bughawk_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Provider (configure one) ---
# Option A: OpenAI
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022

# Option C: Google Gemini
# GOOGLE_API_KEY=your-gemini-api-key
# LLM_PROVIDER=google
# LLM_MODEL=gemini-1.5-pro

# Option D: Demo mode (no LLM calls, uses mock responses)
# LLM_PROVIDER=demo

# --- Security Tools (optional — platform works without them) ---
SUBFINDER_PATH=/usr/local/bin/subfinder
NUCLEI_PATH=/usr/local/bin/nuclei
SEMGREP_PATH=/usr/local/bin/semgrep
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Demo Mode ---
# Local example. Production defaults to false when DEMO_MODE is unset.
# Set DEMO_MODE=true in production only when canned analyst responses are intended.
DEMO_MODE=true
DEMO_ADMIN_EMAIL=demo@bughawk.ai
DEMO_ADMIN_PASSWORD=replace-with-a-demo-password
